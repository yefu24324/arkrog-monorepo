{
  "name": "arkrog-monorepo",
  "private": true,
  "packageManager": "pnpm@11.2.2",
  "scripts": {
    "front:dev": "pnpm --filter arkrog_frontend dev",
    "game:split-topic": "pnpm --filter @arkrog/docs split-topic",
    "graph:ask": "pnpm --filter @arkrog/arknights-knowledge-graph graph:ask",
    "graph:build": "pnpm --filter @arkrog/arknights-knowledge-graph graph:build",
    "graph:cypher": "pnpm --filter @arkrog/arknights-knowledge-graph graph:cypher",
    "graph:export": "pnpm --filter @arkrog/arknights-knowledge-graph graph:export",
    "graph:export:all": "pnpm --filter @arkrog/arknights-knowledge-graph graph:export:all",
    "graph:test": "pnpm --filter @arkrog/arknights-knowledge-graph test",
    "graph:trace": "pnpm --filter @arkrog/arknights-knowledge-graph graph:trace",
    "graph:typecheck": "pnpm --filter @arkrog/arknights-knowledge-graph typecheck",
    "relics:export": "pnpm --filter @arkrog/arknights-knowledge-graph relics:export",
    "schema:bootstrap": "pnpm --filter @arkrog/arknights-schema data:bootstrap",
    "schema:generate": "pnpm schema:bootstrap",
    "schema:analyze": "pnpm --filter @arkrog/arknights-schema data:analyze",
    "schema:inspect": "pnpm --filter @arkrog/arknights-schema data:inspect",
    "schema:validate": "pnpm --filter @arkrog/arknights-schema data:validate",
    "schema:docs:generate": "pnpm --filter @arkrog/arknights-schema-docs docs:generate",
    "schema:docs:dev": "pnpm --filter @arkrog/arknights-schema-docs dev --port 6011",
    "schema:docs:build": "pnpm --filter @arkrog/arknights-schema-docs build"
  }
}
