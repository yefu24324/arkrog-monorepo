{
  "name": "@arkrog/arknights-schema-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "graph:build": "pnpm --filter @arkrog/arknights-knowledge-graph build",
    "graph:export-relic-zones": "pnpm --filter @arkrog/arknights-knowledge-graph graph:export-relic-zones -- all --out packages/arknights-schema-docs/public/data/zone-validation/graph",
    "docs:generate": "arknights-gamedata-report --out public/gamedata-report && pnpm graph:build && pnpm graph:export-relic-zones && tsx scripts/generate-docs.ts",
    "predev": "pnpm docs:generate",
    "dev": "next dev",
    "prebuild": "pnpm docs:generate && fumadocs-mdx",
    "build": "next build",
    "start": "next start",
    "types:check": "pnpm docs:generate && fumadocs-mdx && next typegen && tsc --noEmit",
    "test": "tsx --test src/lib/*.test.ts",
    "postinstall": "fumadocs-mdx",
    "lint": "eslint"
  },
  "dependencies": {
    "@arkrog/arknights-gamedata-report": "workspace:*",
    "@arkrog/arknights-knowledge-graph": "workspace:*",
    "@arkrog/arknights-schema": "workspace:*",
    "@base-ui/react": "^1.6.0",
    "cnfast": "^0.0.8",
    "crypto-js": "^4.2.0",
    "fumadocs-core": "16.11.5",
    "fumadocs-mdx": "15.2.0",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.11.5",
    "lucide-react": "^1.24.0",
    "next": "16.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.1.1",
    "@types/crypto-js": "^4.2.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.10",
    "postcss": "^8.5.17",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.19.4",
    "typescript": "^5.7.3"
  }
}
