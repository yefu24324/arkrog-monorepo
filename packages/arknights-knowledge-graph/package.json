{
  "name": "@arkrog/arknights-knowledge-graph",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "graph:build": "tsx src/cli.ts build",
    "graph:export": "tsx src/cli.ts export",
    "graph:ask": "tsx src/cli.ts ask",
    "graph:trace": "tsx src/cli.ts trace",
    "graph:cypher": "tsx src/cli.ts cypher"
  },
  "dependencies": {
    "@arkrog/arknights-schema": "workspace:*",
    "kuzu": "^0.11.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4.19.4",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}
